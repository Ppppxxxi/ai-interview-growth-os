# Server-only. Keep disabled until task 10 verifies deployment limits and Vercel WAF.
AI_GENERATION_ENABLED=false
DEEPSEEK_API_KEY=
# Required: choose a currently supported JSON-mode model, no default.
DEEPSEEK_MODEL=
# Required in Vercel Project Settings for ALL environments for raw Node streams.
# NOT Next.js api.bodyParser config; absent/nonzero keeps Vercel AI unavailable.
NODEJS_HELPERS=0
# Enable Vercel system environment variables in project settings.
# VERCEL_URL / VERCEL_BRANCH_URL / VERCEL_PROJECT_PRODUCTION_URL are platform supplied.
# Local dev loads .env.local server-side; permits only the actual loopback port.
